
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="FlowPilot helps businesses manage invoices, suppliers, payments and operations with AI-powered workflows.">

  <title>FlowPilot – Your Business Operations Under Control</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: #2457e6;
      --primary-dark: #1742bd;
      --dark: #101828;
      --gray: #667085;
      --light-gray: #f5f7fb;
      --border: #e5e9f2;
      --white: #ffffff;
      --green: #12a76a;
      --radius: 14px;
      --shadow: 0 12px 35px rgba(16,24,40,.07);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--dark);
      background: var(--white);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .container {
      width: min(1120px, 90%);
      margin: 0 auto;
    }

    .section {
      padding: 90px 0;
    }

    .section.light {
      background: var(--light-gray);
    }

    section[id] {
      scroll-margin-top: 90px;
    }

    .eyebrow {
      display: inline-block;
      color: var(--primary);
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .section-heading {
      max-width: 680px;
      margin: 0 auto 48px;
      text-align: center;
    }

    .section-heading h2 {
      font-size: clamp(1.8rem, 4vw, 2.7rem);
      line-height: 1.2;
      margin-bottom: 16px;
      letter-spacing: -1.2px;
    }

    .section-heading p,
    .problem-card p,
    .feature-card p,
    .intro-content p,
    .control-content p {
      color: var(--gray);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 13px 22px;
      border: 1px solid transparent;
      border-radius: 8px;
      font-size: .9rem;
      font-weight: 700;
      cursor: pointer;
      transition: .25s ease;
    }

    .btn-primary {
      background: var(--primary);
      color: var(--white);
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
    }

    .btn-outline {
      border-color: var(--border);
      background: var(--white);
      color: var(--dark);
    }

    .btn-outline:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    /* HEADER */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255,255,255,.97);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(12px);
    }

    .header-inner {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      position: relative;
    }

    /* FLOWPILOT BRAND LOGO */

    .logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 8px 13px;
      background: var(--primary);
      color: var(--white);
      border-radius: 10px;
      font-size: 1.2rem;
      font-weight: 500;
      letter-spacing: -.5px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .logo-symbol {
      display: block;
      width: 43px;
      height: 34px;
      flex-shrink: 0;
    }

    .logo-name strong {
      font-weight: 800;
    }

    .logo-name span {
      font-weight: 400;
    }

    /* NAVIGATION */

    .nav {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav a {
      position: relative;
      color: #475467;
      font-size: .88rem;
      font-weight: 600;
      padding: 10px 0;
      transition: color .2s ease;
    }

    .nav a:hover,
    .nav a.active {
      color: var(--primary);
    }

    .nav a.active::after {
      content: "";
      position: absolute;
      bottom: 2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--primary);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .login-link {
      font-size: .88rem;
      font-weight: 700;
      color: #475467;
    }

    .login-link:hover {
      color: var(--primary);
    }

    .menu-toggle {
      display: none;
      width: 42px;
      height: 42px;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--white);
      cursor: pointer;
    }

    .menu-toggle span {
      width: 19px;
      height: 2px;
      background: var(--dark);
      border-radius: 2px;
      transition: .2s ease;
    }

    .menu-toggle[aria-expanded="true"] span:first-child {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* HERO */

    .hero {
      padding: 90px 0 85px;
      background:
        radial-gradient(circle at 85% 20%, rgba(36,87,230,.10), transparent 30%),
        linear-gradient(180deg,#fbfcff,#ffffff);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 55px;
    }

    .hero h1 {
      max-width: 620px;
      font-size: clamp(2.5rem,5vw,4.2rem);
      line-height: 1.08;
      letter-spacing: -2.5px;
      margin-bottom: 22px;
    }

    .hero h1 span {
      color: var(--primary);
    }

    .hero-description {
      max-width: 510px;
      color: var(--gray);
      font-size: 1.05rem;
      margin-bottom: 30px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 30px;
    }

    .hero-note {
      color: var(--gray);
      font-size: .82rem;
    }

    /* DASHBOARD */

    .dashboard {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
      padding: 20px;
      min-width: 0;
    }

    .dashboard-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--border);
    }

    .dashboard-top h3 {
      font-size: .95rem;
    }

    .dashboard-top span {
      color: var(--green);
      font-size: .75rem;
      font-weight: 700;
    }

    .dashboard-stats {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 12px;
      padding: 20px 0;
    }

    .stat-card {
      background: #f8faff;
      padding: 15px;
      border-radius: 10px;
      border: 1px solid #edf0f7;
      min-width: 0;
    }

    .stat-card small {
      display: block;
      color: var(--gray);
      font-size: .72rem;
      margin-bottom: 7px;
    }

    .stat-card strong {
      font-size: 1.35rem;
    }

    .dashboard-list {
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }

    .dashboard-list h4 {
      padding: 13px;
      font-size: .82rem;
      border-bottom: 1px solid var(--border);
    }

    .dashboard-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 13px;
      border-bottom: 1px solid var(--border);
      font-size: .75rem;
    }

    .dashboard-row:last-child {
      border-bottom: none;
    }

    .status {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 20px;
      font-size: .67rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .status.green {
      color: #087443;
      background: #e7f8ef;
    }

    .status.yellow {
      color: #986000;
      background: #fff5dc;
    }

    .status.blue {
      color: var(--primary);
      background: #eaf0ff;
    }

    /* PROBLEM SECTION */

    .problem-grid {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 22px;
    }

    .problem-card {
      padding: 28px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--white);
      transition: .25s ease;
    }

    .problem-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow);
    }

    .problem-icon {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: #edf2ff;
      color: var(--primary);
      font-size: 1.35rem;
      margin-bottom: 20px;
    }

    .problem-card h3 {
      font-size: 1.1rem;
      margin-bottom: 10px;
    }

    .problem-card p {
      font-size: .9rem;
    }

    /* MEET FLOWPILOT */

    .intro-grid {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      align-items: center;
      gap: 55px;
    }

    .intro-content h2 {
      font-size: clamp(2rem,4vw,2.8rem);
      line-height: 1.2;
      letter-spacing: -1px;
      margin-bottom: 18px;
    }

    .intro-content p {
      margin-bottom: 18px;
    }

    .intro-points {
      display: grid;
      gap: 12px;
      margin-top: 24px;
    }

    .intro-point {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: .92rem;
      font-weight: 600;
    }

    .check {
      display: grid;
      place-items: center;
      flex: 0 0 24px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #e7f8ef;
      color: var(--green);
      font-size: .8rem;
    }

    .intro-visual {
      padding: 30px;
      background: #edf2ff;
      border-radius: 18px;
    }

    .workflow-preview {
      padding: 24px;
      background: var(--white);
      border-radius: 13px;
      box-shadow: var(--shadow);
    }

    .workflow-preview h3 {
      margin-bottom: 20px;
      font-size: 1rem;
    }

    .workflow-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 13px 0;
      border-bottom: 1px solid var(--border);
    }

    .workflow-item:last-child {
      border-bottom: none;
    }

    .workflow-number {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
      border-radius: 9px;
      color: var(--primary);
      background: #edf2ff;
      font-weight: 800;
      font-size: .8rem;
    }

    .workflow-item strong {
      display: block;
      font-size: .86rem;
    }

    .workflow-item small {
      color: var(--gray);
      font-size: .73rem;
    }

    /* WORKFLOW STEPS */

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(6,1fr);
      gap: 14px;
    }

    .step-card {
      text-align: center;
      padding: 22px 12px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
    }

    .step-number {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      margin: 0 auto 14px;
      border-radius: 50%;
      color: var(--white);
      background: var(--primary);
      font-weight: 800;
    }

    .step-card h3 {
      font-size: .85rem;
      margin-bottom: 7px;
    }

    .step-card p {
      color: var(--gray);
      font-size: .72rem;
    }

    /* FEATURES */

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 20px;
    }

    .feature-card {
      padding: 26px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--white);
      transition: .25s ease;
    }

    .feature-card:hover {
      border-color: #b8c8ff;
      box-shadow: var(--shadow);
    }

    .feature-icon {
      font-size: 1.5rem;
      margin-bottom: 15px;
    }

    .feature-card h3 {
      font-size: 1rem;
      margin-bottom: 9px;
    }

    .feature-card p {
      font-size: .86rem;
    }

    /* SUPPLIER TABLE */

    .table-wrapper {
      overflow-x: auto;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
    }

    .supplier-table {
      width: 100%;
      min-width: 620px;
      border-collapse: collapse;
      text-align: left;
    }

    .supplier-table th,
    .supplier-table td {
      padding: 17px 20px;
      border-bottom: 1px solid var(--border);
      font-size: .85rem;
    }

    .supplier-table th {
      color: var(--gray);
      background: #f8faff;
      font-size: .75rem;
      text-transform: uppercase;
      letter-spacing: .5px;
    }

    .supplier-table tr:last-child td {
      border-bottom: none;
    }

    /* APPROVAL CENTER */

    .control-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 35px;
      align-items: center;
    }

    .control-content h2 {
      font-size: clamp(2rem,4vw,2.8rem);
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .control-content p {
      margin-bottom: 22px;
    }

    .approval-card {
      padding: 25px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: var(--shadow);
    }

    .approval-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }

    .approval-header h3 {
      font-size: 1rem;
    }

    .approval-item {
      padding: 16px 0;
      border-top: 1px solid var(--border);
    }

    .approval-item strong {
      display: block;
      font-size: .88rem;
      margin-bottom: 4px;
    }

    .approval-item small {
      color: var(--gray);
      font-size: .77rem;
    }

    .approval-footer {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 15px;
    }

    /* CALL TO ACTION */

    .cta-section {
      padding: 80px 0;
      color: var(--white);
      background: linear-gradient(120deg,#1742bd,#2457e6);
      text-align: center;
    }

    .cta-section h2 {
      max-width: 700px;
      margin: 0 auto 16px;
      font-size: clamp(2rem,4vw,2.9rem);
      line-height: 1.2;
    }

    .cta-section p {
      max-width: 580px;
      margin: 0 auto 28px;
      color: rgba(255,255,255,.83);
    }

    .cta-section .btn {
      color: var(--primary);
      background: var(--white);
    }

    .cta-section .btn:hover {
      transform: translateY(-2px);
      background: #eef2ff;
    }

    /* FOOTER */

    .site-footer {
      padding: 55px 0 25px;
      background: #101828;
      color: var(--white);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 40px;
      padding-bottom: 35px;
    }

    .footer-about p {
      max-width: 330px;
      color: #98a2b3;
      font-size: .85rem;
      margin-top: 16px;
    }

    .footer-column h4 {
      font-size: .9rem;
      margin-bottom: 16px;
    }

    .footer-column a {
      display: block;
      width: fit-content;
      color: #98a2b3;
      font-size: .83rem;
      margin-bottom: 10px;
      transition: color .2s ease;
    }

    .footer-column a:hover {
      color: var(--white);
    }

    .footer-bottom {
      padding-top: 22px;
      border-top: 1px solid #344054;
      color: #98a2b3;
      font-size: .78rem;
      text-align: center;
    }

    /* TABLET */

    @media (max-width: 1000px) {
      .nav {
        gap: 17px;
      }

      .header-inner {
        gap: 15px;
      }

      .steps-grid {
        grid-template-columns: repeat(3,1fr);
      }

      .hero-grid,
      .intro-grid {
        gap: 30px;
      }
    }

    /* MOBILE */

    @media (max-width: 767px) {
      html {
        scroll-padding-top: 75px;
      }

      section[id] {
        scroll-margin-top: 75px;
      }

      .section {
        padding: 65px 0;
      }

      .header-inner {
        min-height: 68px;
      }

      .logo {
        font-size: 1.05rem;
        gap: 8px;
        padding: 7px 10px;
      }

      .logo-symbol {
        width: 38px;
        height: 30px;
      }

      .menu-toggle {
        display: flex;
      }

      .nav {
        position: absolute;
        top: calc(100% + 1px);
        left: 50%;
        transform: translate(-50%,-10px);
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        width: 100vw;
        padding: 10px 5%;
        background: var(--white);
        border-bottom: 1px solid var(--border);
        box-shadow: 0 12px 20px rgba(16,24,40,.08);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
      }

      .nav.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translate(-50%,0);
      }

      .nav a {
        padding: 14px 5%;
        border-bottom: 1px solid #f0f2f5;
      }

      .nav a:last-child {
        border-bottom: none;
      }

      .nav a.active::after {
        display: none;
      }

      .header-actions {
        display: none;
      }

      .hero {
        padding: 65px 0;
      }

      .hero-grid,
      .intro-grid,
      .control-grid {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: clamp(2.3rem,10vw,3.2rem);
        letter-spacing: -1.5px;
      }

      .hero-description {
        font-size: .95rem;
      }

      .hero-buttons {
        gap: 10px;
      }

      .hero-buttons .btn {
        flex: 1 1 145px;
      }

      .dashboard {
        padding: 14px;
      }

      .problem-grid {
        grid-template-columns: 1fr;
      }

      .problem-card {
        padding: 23px;
      }

      .intro-visual {
        padding: 16px;
      }

      .steps-grid {
        grid-template-columns: repeat(2,1fr);
      }

      .features-grid {
        grid-template-columns: repeat(2,1fr);
      }

      .feature-card {
        padding: 20px;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
        gap: 30px;
      }

      .footer-about {
        grid-column: 1 / -1;
      }

      .cta-section {
        padding: 65px 0;
      }
    }

    @media (max-width: 420px) {
      .container {
        width: 92%;
      }

      .features-grid {
        grid-template-columns: 1fr;
      }

      .steps-grid {
        gap: 10px;
      }

      .step-card {
        padding: 18px 9px;
      }

      .dashboard-stats {
        gap: 8px;
      }

      .stat-card {
        padding: 11px;
      }

      .stat-card strong {
        font-size: 1.15rem;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .footer-about {
        grid-column: auto;
      }

      .approval-footer .btn {
        flex: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->

  <header class="site-header">
    <div class="container header-inner">

      <a href="#home" class="logo" aria-label="FlowPilot home">

        <svg class="logo-symbol"
             viewBox="0 0 110 75"
             fill="none"
             xmlns="http://www.w3.org/2000/svg"
             aria-hidden="true">

          <path
            d="M8 43 C19 32 30 12 43 12 C58 12 58 61 73 61 C84 61 94 37 103 29"
            stroke="#FFFFFF"
            stroke-width="12"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
          />

        </svg>

        <span class="logo-name">
          <strong>Flow</strong><span>Pilot</span>
        </span>

      </a>

      <nav class="nav" id="mainNav" aria-label="Main navigation">
        <a href="#product">Product</a>
        <a href="#solutions">Solutions</a>
        <a href="#resources">Resources</a>
        <a href="#home">FlowPilot</a>
      </nav>

      <div class="header-actions">
        <a href="#get-started" class="login-link">Log in</a>
        <a href="#get-started" class="btn btn-primary">Get Started</a>
      </div>

      <button
        class="menu-toggle"
        id="menuToggle"
        type="button"
        aria-label="Open navigation menu"
        aria-controls="mainNav"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

    </div>
  </header>

  <main>

    <!-- HERO -->

    <section class="hero" id="home">
      <div class="container hero-grid">

        <div class="hero-content">
          <span class="eyebrow">AI-powered business operations</span>

          <h1>
            Your Business Operations.
            <span>Under Control.</span>
          </h1>

